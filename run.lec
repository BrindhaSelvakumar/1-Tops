read library -liberty /home/install/FOUNDRY/digital/90nm/dig/lib/slow.lib

set system mode setup

read design -golden -verilog \
/home/student/Desktop/1tops/soc_top.v \
/home/student/Desktop/1tops/risc_core_top.v \
/home/student/Desktop/1tops/fetch_stage.v \
