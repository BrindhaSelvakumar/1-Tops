/home/student/Desktop/1tops/decode_stage.v \
/home/student/Desktop/1tops/main_ctrl.v \
/home/student/Desktop/1tops/sign_gen.v \
/home/student/Desktop/1tops/register_f.v \
/home/student/Desktop/1tops/hazard_unit.v \
/home/student/Desktop/1tops/id_ex_reg.v \
/home/student/Desktop/1tops/execute_stage.v \
/home/student/Desktop/1tops/alu_ctrl_32.v \
/home/student/Desktop/1tops/add_32.v \
/home/student/Desktop/1tops/alu_32.v \
/home/student/Desktop/1tops/prefix_adder_32.v \
/home/student/Desktop/1tops/m_extension_unit.v \
/home/student/Desktop/1tops/forwarding_unit.v \
/home/student/Desktop/1tops/ex_mem_reg.v \
/home/student/Desktop/1tops/memory_stage.v \
/home/student/Desktop/1tops/mem_wb_reg.v \
/home/student/Desktop/1tops/writeback_stage.v \
/home/student/Desktop/1tops/ahb_decoder.v \
/home/student/Desktop/1tops/ahb_dbus_decoder.v \
/home/student/Desktop/1tops/ahb_sram_slave.v \
/home/student/Desktop/1tops/ahb_boot_rom.v

read design -revised -verilog /home/student/Desktop/1tops/soc_top_netlist.v


set root module soc_top

set system mode lec


add compare points -all

compare

report verification > reports/verify.rpt
report unmapped points > reports/unmapped.rpt
report statistics > reports/statistics.rpt
report failing points > reports/failing.rpt

exit
