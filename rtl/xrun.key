database -open waves -into waves.shm -default
probe -create -shm soc_top_tb.clk soc_top_tb.debug_alu_result soc_top_tb.debug_pc soc_top_tb.ext_irq_pad_i soc_top_tb.gpio_dir_pad soc_top_tb.gpio_in_pad soc_top_tb.gpio_out_pad soc_top_tb.rst_n soc_top_tb.spi_master_miso soc_top_tb.spi_master_mosi soc_top_tb.spi_master_sclk soc_top_tb.spi_master_ss_n soc_top_tb.spi_slave_miso soc_top_tb.spi_slave_mosi soc_top_tb.spi_slave_sclk soc_top_tb.spi_slave_ss_n soc_top_tb.uart_rxd soc_top_tb.uart_txd
run
exit
