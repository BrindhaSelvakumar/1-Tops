read library -liberty /home/install/FOUNDRY/digital/90nm/dig/lib/slow.lib


set system mode setup


read design -golden -verilog \
soc_top.v \
risc_core_top.v \
fetch_stage.v \
decode_stage.v \
execute_stage.v \
memory_stage.v \
writeback_stage.v \
if_id_reg.v \
forwarding_unit.v \
alu_ctrl_32.v \
alu_32.v \
main_ctrl.v \
m_extension_unit.v \
id_ex_reg.v \
ex_mem_reg.v \
mem_wb_reg.v \
imm_gen.v \
register_f.v \
hazard_unit.v \
add_32.v \
prefix_adder_32.v \
ahb_boot_rom.v \
ahb_dbus_decoder.v \
ahb_ibus_decoder.v \
ahb_isram_slave.v \
ahb_dsram_slave.v \
ahb_slave_imux.v \
ahb_slave_dmux.v \
ahb_apb_bridge.v \
apb_decoder.v \
sync_fifo.v \
uart_tx.v \
uart_rx.v \
timer_core.v \
apb_uart.v \
apb_timer.v \
apb_spi_master.v \
apb_spi.v \
apb_plic.v \
apb_gpio.v \
apb_clic.v


read design -revised -verilog \
soc_top_netlist.v


set root module soc_top


set system mode lec


add compare points -all

compare

report verification > reports/verify.rpt
report unmapped points > reports/unmapped.rpt
report statistics > reports/statistics.rpt
report failing points > reports/failing.rpt

exit
